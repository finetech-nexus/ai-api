# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
.eggs/

# Small ML weights are committed so builds need no network (see README). The glob
# stays narrow so a new large model dropped in here is not committed by accident.
vendor/kyc/models/*.onnx
!vendor/kyc/models/yunet.onnx
vendor/kyc/models/*.pth

# InsightFace pack: w600k_r50.onnx is 166 MB, over GitHub's hard 100 MB per-file
# limit, so it cannot live in plain git. See README for how it is provisioned.
vendor/kyc/insightface/
*.h5
*.pb

# Env / secrets
.env
.env.local
.env.*.local

# Logs / temp
logs/
temp/
tmp/
*.log

# Tests / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# IDE
.idea/
.vscode/
.DS_Store
