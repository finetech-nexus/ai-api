  "components": {
    "schemas": {
      "AmlHealthResponse": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain",
            "default": "aml"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "not_implemented"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AmlHealthResponse"
      },
      "AmlParty": {
        "properties": {
          "full_name": {
            "type": "string",
            "title": "Full Name",
            "description": "Name to screen"
          },
          "date_of_birth": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Of Birth"
          },
          "nationality": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nationality"
          },
          "document_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Number"
          }
        },
        "type": "object",
        "required": [
          "full_name"
        ],
        "title": "AmlParty"
      },
      "AmlScreenRequest": {
        "properties": {
          "party": {
            "$ref": "#/components/schemas/AmlParty"
          },
          "lists": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Lists",
            "description": "Watchlists to query"
          }
        },
        "type": "object",
        "required": [
          "party"
        ],
        "title": "AmlScreenRequest"
      },
      "AmlScreenResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AmlScreenStatus"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "matches": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Matches"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "title": "AmlScreenResponse"
      },
      "AmlScreenStatus": {
        "type": "string",
        "enum": [
          "clear",
          "potential_match",
          "confirmed_match",
          "error"
        ],
        "title": "AmlScreenStatus"
      },
      "Body_extract_ocr_api_v1_kyc_ocr_post": {
        "properties": {
          "document": {
            "type": "string",
            "format": "binary",
            "title": "Document",
            "description": "Document image for OCR"
          }
        },
        "type": "object",
        "required": [
          "document"
        ],
        "title": "Body_extract_ocr_api_v1_kyc_ocr_post"
      },
      "Body_extract_ocr_legacy_api_v1_ocr_extract_post": {
        "properties": {
          "document": {
            "type": "string",
            "format": "binary",
            "title": "Document",
            "description": "Document image for OCR"
          }
        },
        "type": "object",
        "required": [
          "document"
        ],
        "title": "Body_extract_ocr_legacy_api_v1_ocr_extract_post"
      },
      "Body_verify_kyc_api_v1_kyc_verify_post": {
        "properties": {
          "id_document": {
            "type": "string",
            "format": "binary",
            "title": "Id Document",
            "description": "ID card or passport image"
          },
          "selfie_image": {
            "type": "string",
            "format": "binary",
            "title": "Selfie Image",
            "description": "Selfie photo"
          }
        },
        "type": "object",
        "required": [
          "id_document",
          "selfie_image"
        ],
        "title": "Body_verify_kyc_api_v1_kyc_verify_post"
      },
      "ChallengeResponse": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "title": "Challenge Id"
          },
          "multi_challenge": {
            "type": "boolean",
            "title": "Multi Challenge",
            "default": false
          },
          "challenge_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChallengeType"
              },
              {
                "type": "null"
              }
            ]
          },
          "question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "instruction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instruction"
          },
          "challenge_types": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ChallengeType"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Challenge Types"
          },
          "questions": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Questions"
          },
          "instructions": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instructions"
          },
          "timestamp": {
            "type": "number",
            "title": "Timestamp"
          },
          "expires_at": {
            "type": "number",
            "title": "Expires At"
          },
          "nonce": {
            "type": "string",
            "title": "Nonce"
          },
          "signature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Signature"
          }
        },
        "type": "object",
        "required": [
          "challenge_id",
          "timestamp",
          "expires_at",
          "nonce"
        ],
        "title": "ChallengeResponse"
      },
      "ChallengeStatus": {
        "type": "string",
        "enum": [
          "pass",
          "fail",
          "pending",
          "expired",
          "invalid"
        ],
        "title": "ChallengeStatus"
      },
      "ChallengeType": {
        "type": "string",
        "enum": [
          "blink",
          "turn_left",
          "turn_right"
        ],
        "title": "ChallengeType"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error",
            "description": "Error type"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable error message"
          },
          "details": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "title": "ErrorResponse",
        "example": {
          "details": {
            "confidence_threshold": 0.6
          },
          "error": "ValidationError",
          "message": "No face detected in ID document",
          "timestamp": "2024-10-11T10:30:00Z"
        }
      },
      "FaceMatchData": {
        "properties": {
          "verified": {
            "type": "boolean",
            "title": "Verified",
            "description": "Whether faces match"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Match confidence score"
          },
          "similarity_metrics": {
            "$ref": "#/components/schemas/SimilarityMetrics"
